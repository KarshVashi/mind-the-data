{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Methodology",
  "description": "meta/methodology.json: the weights, thresholds and open decisions behind the published numbers.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "data_window",
    "completeness",
    "git_sha",
    "severity_weights",
    "time_bands",
    "disruption_index",
    "thresholds",
    "measured_view_withheld_lines",
    "trains_run_withheld_lines",
    "views",
    "open_decisions",
    "settled_decisions"
  ],
  "properties": {
    "schema_version": {"$ref": "league.schema.json#/$defs/schema_version"},
    "generated_at": {"$ref": "league.schema.json#/$defs/utc_timestamp"},
    "data_window": {"$ref": "league.schema.json#/$defs/data_window"},
    "completeness": {"$ref": "league.schema.json#/$defs/nullable_share"},
    "git_sha": {"$ref": "league.schema.json#/$defs/git_sha"},
    "severity_weights": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "severity_code",
          "description",
          "weight_unplanned",
          "weight_planned",
          "is_closure",
          "is_service_closed",
          "source"
        ],
        "properties": {
          "severity_code": {"type": "integer", "minimum": 0},
          "description": {"type": "string"},
          "weight_unplanned": {"type": "number", "minimum": 0},
          "weight_planned": {"type": "number", "minimum": 0},
          "is_closure": {"type": "boolean"},
          "is_service_closed": {"type": "boolean"},
          "source": {"type": "string"}
        }
      }
    },
    "time_bands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "day_class",
          "time_band",
          "start_minute",
          "end_minute",
          "time_weight"
        ],
        "properties": {
          "day_class": {"enum": ["weekday", "weekend"]},
          "time_band": {"type": "string"},
          "start_minute": {"type": "integer", "minimum": 0, "maximum": 1440},
          "end_minute": {"type": "integer", "minimum": 0, "maximum": 1440},
          "time_weight": {"type": "number", "exclusiveMinimum": 0}
        }
      }
    },
    "disruption_index": {
      "description": "How the Disruption Index is computed and its range (D19).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "definition",
        "min",
        "max"
      ],
      "properties": {
        "definition": {"type": "string", "minLength": 1},
        "min": {"type": "number"},
        "max": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provisional_completeness",
        "closure_share_provisional",
        "min_open_share_to_rank",
        "incident_merge_gap_minutes",
        "gate_low_ratio",
        "gate_high_ratio",
        "gate_max_out_of_band_share",
        "min_measured_share"
      ],
      "properties": {
        "provisional_completeness": {"$ref": "league.schema.json#/$defs/share"},
        "closure_share_provisional": {"$ref": "league.schema.json#/$defs/share"},
        "min_open_share_to_rank": {
          "description": "A line is ranked only if it ran at least this share of its scheduled minutes (D22).",
          "$ref": "league.schema.json#/$defs/share"
        },
        "incident_merge_gap_minutes": {"type": "integer", "minimum": 0},
        "gate_low_ratio": {
          "description": "An hour is inside the quality gate when inferred trains are at least this share of the trains on the boards (ADR-014).",
          "type": "number",
          "exclusiveMinimum": 0
        },
        "gate_high_ratio": {
          "description": "... and at most this share.",
          "type": "number",
          "exclusiveMinimum": 0
        },
        "gate_max_out_of_band_share": {
          "description": "A line-week's measured numbers are withheld when more than this share of its judged hours falls outside the gate (D51).",
          "$ref": "league.schema.json#/$defs/share"
        },
        "min_measured_share": {
          "description": "A line-week's measured numbers are withheld when under this share of its scheduled station-direction-hours is measured (D42).",
          "$ref": "league.schema.json#/$defs/share"
        }
      }
    },
    "measured_view_withheld_lines": {
      "description": "Lines whose measured view is withheld because their boards misfile trains on a shared section (D52).",
      "type": "array",
      "items": {"$ref": "league.schema.json#/$defs/line_id"},
      "uniqueItems": true
    },
    "trains_run_withheld_lines": {
      "description": "Lines whose trains-run share is withheld for the same reason (ADR-014).",
      "type": "array",
      "items": {"$ref": "league.schema.json#/$defs/line_id"},
      "uniqueItems": true
    },
    "views": {"$ref": "league.schema.json#/$defs/views"},
    "open_decisions": {
      "type": "array",
      "items": {"$ref": "league.schema.json#/$defs/decision_id"},
      "uniqueItems": true
    },
    "settled_decisions": {
      "description": "Owner decisions behind the published numbers that have been settled (docs/DECISIONS.md).",
      "type": "array",
      "items": {"$ref": "league.schema.json#/$defs/decision_id"},
      "uniqueItems": true
    }
  }
}
