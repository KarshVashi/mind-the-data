{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Open dataset manifest",
  "description": "open-data/{yyyy-mm}/manifest.json: the Parquet files of one London month's open dataset (M7), with their rows, sizes, checksums and columns, the TfL attribution and the licence (D63). README.md beside it is written from the same document.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "data_window",
    "completeness",
    "git_sha",
    "data_through",
    "attribution",
    "licence",
    "datasets"
  ],
  "properties": {
    "schema_version": {"$ref": "league.schema.json#/$defs/schema_version"},
    "generated_at": {"$ref": "league.schema.json#/$defs/utc_timestamp"},
    "data_window": {
      "description": "The London calendar month, inclusive.",
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "timezone", "month"],
      "properties": {
        "start": {"$ref": "league.schema.json#/$defs/london_date"},
        "end": {"$ref": "league.schema.json#/$defs/london_date"},
        "timezone": {"const": "Europe/London"},
        "month": {"type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"}
      }
    },
    "completeness": {
      "description": "Observed / scheduled line-minutes over the month; null with nothing scheduled.",
      "$ref": "league.schema.json#/$defs/nullable_share"
    },
    "git_sha": {"$ref": "league.schema.json#/$defs/git_sha"},
    "data_through": {
      "description": "The newest minute in the data, London wall-clock time.",
      "oneOf": [{"type": "null"}, {"$ref": "league.schema.json#/$defs/london_timestamp"}]
    },
    "attribution": {"const": "Powered by TfL Open Data"},
    "licence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "source_terms", "decision"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "url": {"type": "string", "pattern": "^https://"},
        "source_terms": {"type": "string", "pattern": "^https://"},
        "decision": {"type": "string", "pattern": "^D\\d+$"}
      }
    },
    "datasets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description", "grain", "source_model", "rows", "files", "columns"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z_]*$"},
          "description": {"type": "string", "minLength": 1},
          "grain": {"type": "string", "minLength": 1},
          "source_model": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "rows": {"type": "integer", "minimum": 0},
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "bytes", "sha256"],
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^open-data/\\d{4}-\\d{2}/[a-z][a-z_]*(-\\d{3})?\\.parquet$"
                },
                "bytes": {"type": "integer", "minimum": 12},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              }
            }
          },
          "columns": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "type", "description"],
              "properties": {
                "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
                "type": {"type": "string", "minLength": 1},
                "description": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    }
  }
}
