{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Season table",
  "description": "season/{season}.json (PLAN 8, M6, D58): declared-view standings from 1 April to 31 March, London dates. data_window spans the dates observed so far; the 2026-27 season starts with the collector.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "data_window",
    "completeness",
    "git_sha",
    "season",
    "season_start",
    "season_end",
    "is_season_complete",
    "lines",
    "open_decisions"
  ],
  "properties": {
    "schema_version": {
      "$ref": "league.schema.json#/$defs/schema_version"
    },
    "generated_at": {
      "$ref": "league.schema.json#/$defs/utc_timestamp"
    },
    "data_window": {
      "$ref": "league.schema.json#/$defs/data_window"
    },
    "completeness": {
      "$ref": "league.schema.json#/$defs/nullable_share"
    },
    "git_sha": {
      "$ref": "league.schema.json#/$defs/git_sha"
    },
    "season": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}$"
    },
    "season_start": {
      "$ref": "league.schema.json#/$defs/london_date"
    },
    "season_end": {
      "$ref": "league.schema.json#/$defs/london_date"
    },
    "is_season_complete": {
      "type": "boolean"
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "line_id",
          "line_name",
          "rank",
          "unranked_reason",
          "disruption_index",
          "good_service_pct",
          "incidents",
          "incidents_per_100_hours",
          "engineering_works_hours",
          "completeness",
          "is_provisional"
        ],
        "properties": {
          "line_id": {
            "$ref": "league.schema.json#/$defs/line_id"
          },
          "line_name": {
            "type": "string",
            "minLength": 1
          },
          "rank": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "unranked_reason": {
            "$ref": "league.schema.json#/$defs/unranked_reason"
          },
          "disruption_index": {
            "$ref": "league.schema.json#/$defs/nullable_non_negative"
          },
          "good_service_pct": {
            "$ref": "league.schema.json#/$defs/nullable_non_negative"
          },
          "incidents": {
            "type": "integer",
            "minimum": 0
          },
          "incidents_per_100_hours": {
            "$ref": "league.schema.json#/$defs/nullable_non_negative"
          },
          "engineering_works_hours": {
            "type": "number",
            "minimum": 0
          },
          "completeness": {
            "$ref": "league.schema.json#/$defs/nullable_share"
          },
          "is_provisional": {
            "type": "boolean"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "rank": {
                  "type": "integer"
                }
              },
              "required": [
                "rank"
              ]
            },
            "then": {
              "properties": {
                "unranked_reason": {
                  "type": "null"
                }
              }
            },
            "else": {
              "properties": {
                "unranked_reason": {
                  "type": "string"
                }
              }
            }
          }
        ]
      }
    },
    "open_decisions": {
      "type": "array",
      "items": {
        "$ref": "league.schema.json#/$defs/decision_id"
      },
      "uniqueItems": true
    }
  }
}
