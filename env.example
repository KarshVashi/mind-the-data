# Copy to .env for local runs (cp env.example .env). .env is gitignored; never commit real values.
# Nothing here is needed for `make check`, which runs fully offline.

# ---- TfL ---------------------------------------------------------------
# Optional locally. Without it the client runs anonymously at TfL's lower
# rate limit and logs a warning. In Lambda the key is read from SSM at
# /mind-the-data/tfl/app_key instead.
TFL_APP_KEY=

# ---- AWS ---------------------------------------------------------------
# Read-only dev profile (human step H4).
AWS_PROFILE=mtd-dev
AWS_REGION=eu-west-2

# ---- dbt (transform/profiles.yml) --------------------------------------
# Target used when --target is not given: dev or prod.
DBT_TARGET=dev

# dev target. Required by `make dbt-build-dev`; the Terraform output
# dbt_athena_env has every value (docs/runbook.md, dbt connection settings).
# The schema is the Glue database dbt writes to; IAM allows mind_the_data_dev
# only (docs/policies/mtd-dev-athena.json).
DBT_ATHENA_S3_STAGING_DIR_DEV=
DBT_ATHENA_S3_DATA_DIR_DEV=
DBT_ATHENA_WORKGROUP_DEV=
DBT_ATHENA_SCHEMA_DEV=mind_the_data_dev

# prod target. Set in CI only (repository variables); leave empty locally.
DBT_ATHENA_S3_STAGING_DIR_PROD=
DBT_ATHENA_S3_DATA_DIR_PROD=
DBT_ATHENA_WORKGROUP_PROD=
DBT_ATHENA_SCHEMA_PROD=mind_the_data_prod
