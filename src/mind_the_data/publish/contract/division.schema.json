{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Divisions for a month",
  "description": "divisions/{yyyy-mm}.json (PLAN 8, M6). status says what the month holds: not_seeded (fewer complete weeks than the seeding needs; no table), seeded (the seeding exists and the divisions start in a later month), in_progress or complete. The seeding is labelled provisional while fewer than four complete weeks exist (ADR-015).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "data_window",
    "completeness",
    "git_sha",
    "month",
    "status",
    "complete_weeks_available",
    "seeding",
    "divisions",
    "open_decisions"
  ],
  "properties": {
    "schema_version": {
      "$ref": "league.schema.json#/$defs/schema_version"
    },
    "generated_at": {
      "$ref": "league.schema.json#/$defs/utc_timestamp"
    },
    "data_window": {
      "$ref": "league.schema.json#/$defs/data_window"
    },
    "completeness": {
      "$ref": "league.schema.json#/$defs/nullable_share"
    },
    "git_sha": {
      "$ref": "league.schema.json#/$defs/git_sha"
    },
    "month": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}$"
    },
    "status": {
      "$ref": "#/$defs/status"
    },
    "complete_weeks_available": {
      "type": "integer",
      "minimum": 0
    },
    "seeding": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "weeks",
            "start",
            "end",
            "first_division_month",
            "lines"
          ],
          "properties": {
            "status": {
              "enum": [
                "provisional",
                "confirmed"
              ]
            },
            "weeks": {
              "type": "integer",
              "minimum": 1
            },
            "start": {
              "$ref": "league.schema.json#/$defs/london_date"
            },
            "end": {
              "$ref": "league.schema.json#/$defs/london_date"
            },
            "first_division_month": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}$"
            },
            "lines": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "line_id",
                  "line_name",
                  "seed_position",
                  "division",
                  "disruption_index",
                  "good_service_pct",
                  "unranked_reason"
                ],
                "properties": {
                  "line_id": {
                    "$ref": "league.schema.json#/$defs/line_id"
                  },
                  "line_name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "seed_position": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "division": {
                    "enum": [
                      1,
                      2
                    ]
                  },
                  "disruption_index": {
                    "$ref": "league.schema.json#/$defs/nullable_non_negative"
                  },
                  "good_service_pct": {
                    "$ref": "league.schema.json#/$defs/nullable_non_negative"
                  },
                  "unranked_reason": {
                    "$ref": "league.schema.json#/$defs/unranked_reason"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "divisions": {
      "description": "Empty unless status is in_progress or complete.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "division",
          "name",
          "lines"
        ],
        "properties": {
          "division": {
            "enum": [
              1,
              2
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "line_id",
                "line_name",
                "rank",
                "unranked_reason",
                "joined_by",
                "disruption_index",
                "good_service_pct",
                "completeness",
                "is_provisional",
                "movement",
                "movement_held_reason",
                "next_division"
              ],
              "properties": {
                "line_id": {
                  "$ref": "league.schema.json#/$defs/line_id"
                },
                "line_name": {
                  "type": "string",
                  "minLength": 1
                },
                "rank": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1
                },
                "unranked_reason": {
                  "$ref": "league.schema.json#/$defs/unranked_reason"
                },
                "joined_by": {
                  "enum": [
                    "seeded",
                    "promoted",
                    "relegated",
                    "stayed"
                  ]
                },
                "disruption_index": {
                  "$ref": "league.schema.json#/$defs/nullable_non_negative"
                },
                "good_service_pct": {
                  "$ref": "league.schema.json#/$defs/nullable_non_negative"
                },
                "completeness": {
                  "$ref": "league.schema.json#/$defs/nullable_share"
                },
                "is_provisional": {
                  "type": "boolean"
                },
                "movement": {
                  "description": "At the month's end: promoted, relegated or stays. While the month runs, where the line stands.",
                  "enum": [
                    "promoted",
                    "relegated",
                    "stays"
                  ]
                },
                "movement_held_reason": {
                  "description": "provisional_month when the month was provisional (a ranked line observed under 90%), so no line moved whatever its rank (D57); otherwise null.",
                  "enum": [
                    null,
                    "provisional_month"
                  ]
                },
                "next_division": {
                  "enum": [
                    1,
                    2
                  ]
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "rank": {
                        "type": "integer"
                      }
                    },
                    "required": [
                      "rank"
                    ]
                  },
                  "then": {
                    "properties": {
                      "unranked_reason": {
                        "type": "null"
                      }
                    }
                  },
                  "else": {
                    "properties": {
                      "unranked_reason": {
                        "type": "string"
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "open_decisions": {
      "type": "array",
      "items": {
        "$ref": "league.schema.json#/$defs/decision_id"
      },
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "not_seeded"
          }
        }
      },
      "then": {
        "properties": {
          "seeding": {
            "type": "null"
          },
          "divisions": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "seeded",
              "pending"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "seeding": {
            "type": "object"
          },
          "divisions": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "in_progress",
              "complete"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "seeding": {
            "type": "object"
          },
          "divisions": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "status": {
      "description": "not_seeded: too few complete weeks, no table. seeded: the seeding exists and the divisions start in a later month. pending: a division month the build has not reached yet. in_progress or complete: the month's divisions.",
      "enum": [
        "not_seeded",
        "seeded",
        "pending",
        "in_progress",
        "complete"
      ]
    }
  }
}
